[sub_resource type="Shader" id="Shader_kvuet"]
code = "shader_type canvas_item;

uniform vec4 color: source_color;

uniform float outerRadius : hint_range(0.0, 5.0) = 1.0;
uniform float MainAlpha : hint_range(0.0, 1.0) = 1.0;

void fragment() {
	float x = abs(UV.x-.5)*2.0;
	float y = abs(UV.y-.5)*2.0;
	float v = (sqrt((2.0*x*x*x*x*x*x*x*x*x*x)+(2.0*y*y*y*y*y*y*y*y*y*y))/(outerRadius));
	COLOR = vec4(color.xyz,v*MainAlpha);
}"

