[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ColorParameter : source_color;
uniform vec4 ColorParameter2 : source_color;
uniform sampler2D Texture2DParameter;



void fragment() {
// ColorParameter:4
	vec4 n_out4p0 = ColorParameter;


// ColorParameter:5
	vec4 n_out5p0 = ColorParameter2;


// Input:7
	vec2 n_out7p0 = UV;


// Input:11
	float n_out11p0 = TIME;


// VectorCompose:13
	float n_in13p1 = 0.00000;
	vec2 n_out13p0 = vec2(n_out11p0, n_in13p1);


// VectorOp:12
	vec2 n_out12p0 = n_out7p0 + n_out13p0;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture2DParameter, n_out12p0);


// Mix:6
	vec4 n_out6p0 = mix(n_out4p0, n_out5p0, n_out3p0);


// Output:0
	COLOR.rgb = vec3(n_out6p0.xyz);


}
"
