[sub_resource type="GDScript" id="GDScript_hf8iu"]
script/source = "## DAMAGE CARD
# Deals damage to opponent
extends Card
class_name DamageCard

@export var damage_amount : float = 1.0

func play_card(character: int = 0):
	if character == 0:
		print(\"Dealing \" + str(damage_amount) + \" damage to devil\")
		GameManager.deal_damage(1, damage_amount)
	else:
		print(\"Dealing \" + str(damage_amount) + \" damage to player\")
		GameManager.deal_damage(0, damage_amount)
"

