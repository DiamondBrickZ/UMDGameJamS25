[sub_resource type="GDScript" id="GDScript_vx1k0"]
script/source = "## COIN BAG CARD
extends Card
class_name CoinBag

@export var gold_amount : int = 5

func play_card(character: int = 0):
	print(\"Character \" + str(character) + \" gaining \" + str(gold_amount) + \" gold!\")
	GameManager.game_info[character][\"gold\"] += gold_amount
	return true
"

